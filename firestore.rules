rules_version = '2';

// OBMS Tender System — Firestore Security Rules
// Principle (from procurement constitution): security rules are a HARD GATE.
// All status transitions / privileged writes go through Cloud Functions (Admin SDK
// bypasses these rules). The client may only do the narrow reads/writes allowed below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.role : '';
    }
    function isInternal() {
      return role() in ['tender_manager', 'requester', 'legal', 'security', 'finance'];
    }
    function isManager() {
      return role() == 'tender_manager';
    }
    function isSupplier() {
      return role() == 'supplier';
    }
    function supplierId() {
      return isSignedIn() ? request.auth.token.supplierId : '';
    }
    // Strict case teams: tender managers see every case; any other internal role only the cases
    // whose team (tender.memberUids) they belong to.
    function isCaseMember(tenderId) {
      return isManager()
        || (isInternal()
            && request.auth.uid in get(/databases/$(database)/documents/tenders/$(tenderId)).data.get('memberUids', []));
    }
    // Suppliers have NO direct database access: everything they see comes through Cloud Functions
    // (supplierListTenders / supplierGetTender / getTenderDocument / askQuestion / saveSubmission),
    // which return safe projections only. No rule below grants a supplier anything.
    function canSeeTender(tenderId) {
      return isCaseMember(tenderId);
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isInternal() && (request.auth.uid == uid || isManager());
      allow write: if false; // function-only (setUserRole / seed)
    }

    // ---- suppliers (master data) ----
    match /suppliers/{supplierDocId} {
      allow read: if isInternal();
      allow write: if false; // function-only
    }

    // ---- templates ----
    match /templates/{templateId} {
      allow read: if isInternal();
      allow write: if false; // function-only (seed / manager via function)

      // template-conversion proposals awaiting manager review
      match /conversions/{runId} {
        allow read: if isManager();
        allow write: if false; // function-only (analyzeTemplateFields)
      }
    }

    // ---- tenders ----
    match /tenders/{tenderId} {
      // Non-manager internal users list their cases with where('memberUids','array-contains',uid).
      // Suppliers read a safe projection through supplierGetTender — never this document.
      allow read: if isManager()
        || (isInternal() && request.auth.uid in resource.data.get('memberUids', []));
      allow write: if false; // function-only (FSM, audit)

      // internal-only data: provenance (template/skills/AI draft) + confidential params (G6)
      match /internal/{docId} {
        allow read: if isCaseMember(tenderId);
        allow write: if false; // function-only (createTender)
      }

      // supervisor agent reports (one per run)
      match /supervision/{runId} {
        allow read: if isCaseMember(tenderId);
        allow write: if false; // function-only (superviseTender)
      }

      // access grants (internal only; suppliers get their cases from supplierListTenders)
      match /access/{principalId} {
        allow read: if isCaseMember(tenderId);
        allow write: if false; // function-only (grantAccess / assignTeamMember)
      }

      // internal chat of the case team — members and managers only, never suppliers. Messages are
      // immutable (part of the case record); identity and time are enforced, not client-supplied.
      match /chat/{messageId} {
        allow read: if isCaseMember(tenderId);
        allow create: if isCaseMember(tenderId)
          && request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'role', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == role()
          && request.resource.data.id == messageId
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
      // per-user read marker for the chat's unread count
      match /chatReads/{uid} {
        allow read: if isCaseMember(tenderId) && uid == request.auth.uid;
        allow write: if isCaseMember(tenderId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
      }

      // clarification questions — authorized suppliers see each other's questions, but these
      // documents are ANONYMOUS: the asker's identity lives in /questionAuthors below. Rules
      // cannot hide fields from a read, so identity must not be stored here at all.
      match /questions/{questionId} {
        allow read: if canSeeTender(tenderId);
        // function-only (askQuestion). Client creation is denied: it was the one path by which a
        // supplier could write identity fields back into an anonymous question document.
        allow write: if false;
      }

      // who asked each question. Internal users see all; a supplier sees ONLY their own, which
      // lets the UI mark their question without revealing any competitor's participation.
      // Authorized on the principal FIELD (like /access above) so the supplier's
      // where('supplierId','==',me) query is allowed.
      match /questionAuthors/{questionId} {
        allow read: if isCaseMember(tenderId);
        allow write: if false; // function-only (askQuestion)
      }

      // manager answers — visible to all authorized principals
      match /answers/{answerId} {
        allow read: if canSeeTender(tenderId);
        allow write: if false; // function-only (answerQuestions)
      }

      // submissions — managers read; suppliers write only through saveSubmission (deadline, own
      // folder and lengths checked there) and read their own through supplierGetTender
      match /submissions/{ownerSupplierId} {
        allow read: if isManager();
        allow write: if false;
      }
    }

    // ---- participant feedback: owner + managers read; function-only writes ----
    match /feedbackRequests/{requestId} {
      allow read: if isInternal() && (resource.data.uid == request.auth.uid || isManager());
      allow write: if false; // function-only (createFeedbackRequests / submitFeedback)
    }
    match /tenders/{tenderId}/feedback/{feedbackId} {
      allow read: if isInternal() && (resource.data.uid == request.auth.uid || isManager());
      allow write: if false; // function-only (submitFeedback)
    }
    match /{path=**}/feedback/{feedbackId} {
      allow read: if isManager();
    }
    match /skillTips/{type}/runs/{runId} {
      allow read: if isManager();
      allow write: if false; // function-only (generateSkillTips)
    }

    // ---- per-case success scores + scoring settings (internal analytics) ----
    match /caseScores/{tenderId} {
      allow read: if isCaseMember(tenderId);
      allow write: if false; // function-only (scoreService)
    }
    match /settings/{settingId} {
      allow read: if isInternal();
      allow write: if false; // function-only (updateScoringTargets)
    }

    // ---- bid requests (phase 1) ----
    // The requester sees their own; managers see all. Created and converted by functions only.
    match /bidRequests/{serial} {
      allow read: if isManager() || (isInternal() && resource.data.requesterUid == request.auth.uid);
      allow write: if false;

      // requirement research (agent): the request's owner and managers; function-only writes
      match /research/{runId} {
        allow read: if isManager()
          || (isInternal()
              && get(/databases/$(database)/documents/bidRequests/$(serial)).data.requesterUid == request.auth.uid);
        allow write: if false;
      }
    }

    // web research run on a request before it was sent: returned by the function, linked on send
    match /researchDrafts/{runId} {
      allow read, write: if false;
    }

    // ---- audit log (immutable, append-only via functions) ----
    // managers read everything; team members only the trail of their own cases (queried by tenderId)
    match /auditLog/{entryId} {
      allow read: if isManager()
        || (isInternal() && resource.data.get('tenderId', null) is string
            && isCaseMember(resource.data.tenderId));
      allow write: if false; // function-only
    }

    // Collection-group reads. Nested match rules above secure direct gets/writes; these
    // additional rules authorize collectionGroup() queries (supplier portal + reports).
    match /{path=**}/access/{accessId} {
      allow read: if isManager()
        || (isInternal() && resource.data.principalId == request.auth.uid);
    }
    match /{path=**}/submissions/{ownerSupplierId} {
      allow read: if isManager();
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
