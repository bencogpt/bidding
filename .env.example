# Admin service account for local seed scripts, CLI, and (later) Google Docs API.
# Point this at the JSON key you downloaded. NEVER commit the actual file.
GOOGLE_APPLICATION_CREDENTIALS=/Users/<you>/Downloads/biding-system-firebase-adminsdk-fbsvc-f6972a0a99.json

# Default Storage bucket for the admin SDK (functions / seed).
STORAGE_BUCKET=biding-system.firebasestorage.app

# Seed target: emulator (default) or real
# SEED_TARGET=real

# --- Google Docs mode (functions) ---
# Off by default (dev renders the doc to HTML). When true, functions copy a Google Docs
# template, fill params, export a PDF, and set per-user permissions. Requires the service
# account to have Drive+Docs access and the template Doc IDs to be set on each `templates/*`.
# USE_GOOGLE_DOCS=true
# Folder (inside a Shared Drive the service account can write to) for generated docs:
# GOOGLE_DRIVE_PARENT_ID=

# --- Claude / Anthropic (functions) ---
# Used for question clustering + comparative analysis. Without it, both fall back to a
# labeled local heuristic. In production store this in Secret Manager, not a committed file.
# Stored in Secret Manager as ANTHROPIC_API_KEY (bound to clusterTenderQuestions + runComparison).
# Do NOT put the real key in this committed file. To rotate: gcloud secrets versions add ANTHROPIC_API_KEY --data-file=-
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CLUSTER_MODEL=claude-sonnet-4-6
# ANTHROPIC_COMPARE_MODEL=claude-opus-4-8

# --- web (Vite) overrides; defaults are baked into web/src/lib/firebase.ts ---
# VITE_USE_EMULATOR=false   # set false to run the web app against the LIVE project

# --- Firebase App Check (web) — see RUNNING.md "App Check" ---
# Public reCAPTCHA Enterprise web site key (phase 0). App Check stays off until this is set.
# VITE_APPCHECK_SITE_KEY=
# Local dev / emulator only: debug token registered in Firebase console → App Check →
# Manage debug tokens. NEVER commit a real token.
# VITE_APPCHECK_DEBUG_TOKEN=
